{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "electron/services/bridgeManager.ts",
    "electron/services/bridgeWechatSource.ts",
    "shared/**/*.ts",
    "shared/**/*.json"
  ]
}
